# ==========================================
# SecureAuth Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment: development | production | test
NODE_ENV=development

# MongoDB Connection String (e.g., local MongoDB or MongoDB Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/secureauth

# JWT Authentication Secret & Expiration
JWT_SECRET=secureauth_ultra_secure_jwt_production_secret_key_change_me
JWT_EXPIRES_IN=1d

# Frontend Application URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Gmail SMTP Email Configuration (for Real OTP Delivery)
# Note: For Gmail, use an App Password generated at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SecureAuth Identity" <no-reply@secureauth.io>

# Optional: Enable in-memory MongoDB fallback if local mongod is not installed
ENABLE_MEMORY_DB=true
